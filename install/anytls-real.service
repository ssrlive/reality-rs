[Unit]
Description=anyreality (REALITY + anytls) server
After=network.target

[Service]
Type=simple
WorkingDirectory=/etc/anyreality
ExecStart=/usr/local/bin/anyreality-server --config /etc/anyreality/config.toml
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
